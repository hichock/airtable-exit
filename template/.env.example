# Copy to .env.local. Never commit real values. Vercel gets the same names (Project → Settings → Environment Variables).

# Run with fake in-memory data (no Supabase needed). Remove in production.
DEMO=1

# Supabase (Project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by migration scripts, the nightly sync and public forms. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app: sign-in and invite emails link to <this>/auth/callback. localhost is only for local work;
# after the first deploy set the live https URL here AND in Vercel (npm run invite refuses localhost).
# Supabase → Authentication → URL Configuration needs the same Site URL and <url>/auth/callback (npm run auth:check).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Airtable read-only personal access token, for the data copy and the nightly sync during the parallel run.
# Scopes: schema.bases:read, data.records:read, data.recordComments:read, workspacesAndBases:read, user.email:read
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# Files bigger than this (MB) are not copied to Storage, only listed. 50 = Supabase Free per-file limit.
# Raise it only on Supabase Pro after raising the limit in Storage settings.
MAX_FILE_MB=50

# Vercel cron calls /api/cron/* with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# Set to 1 only during the parallel run. The nightly sync does nothing otherwise.
SYNC_ENABLED=0
# Set to 1 at cutover, after Airtable's automations are off. Rebuilt automations skip until then.
AUTOMATIONS_ENABLED=0
