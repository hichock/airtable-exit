{
  "name": "airtable-exit-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Your own CRM after Airtable: Next.js + Supabase, driven by app.schema.json.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "demo": "DEMO=1 next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"lib/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "schema:check": "tsx scripts/schema-check.ts",
    "schema:sql": "tsx scripts/schema-sql.ts",
    "schema:from-airtable": "tsx scripts/schema-from-airtable/cli.ts",
    "migrate:copy": "tsx scripts/migrate/copy.ts",
    "migrate:parity": "tsx scripts/migrate/parity.ts",
    "report:html": "tsx scripts/report/render.ts",
    "invite": "tsx scripts/invite.ts",
    "test:migrations": "bash scripts/test-migrations-local.sh",
    "airtable:inventory": "tsx scripts/airtable/inventory.ts",
    "auth:check": "tsx scripts/auth-check.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
