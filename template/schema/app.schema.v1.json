{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hichock/airtable-exit/main/template/schema/app.schema.v1.json",
  "title": "airtable-exit app.schema.json (v1)",
  "description": "Describes the app the template renders. Structure only: cross-references (link targets, view columns, formula fields) are checked by lib/schema/validate.ts (npm run schema:check).",
  "type": "object",
  "required": [
    "version",
    "app",
    "tables",
    "dashboards",
    "forms",
    "roles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "app": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "locale": {
          "type": "string"
        },
        "timeZone": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "dashboards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dashboard"
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/form"
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "read",
          "write"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,50}$"
          },
          "label": {
            "type": "string"
          },
          "read": {
            "oneOf": [
              {
                "const": "*"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "write": {
            "oneOf": [
              {
                "const": "*"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "table": {
      "type": "object",
      "required": [
        "key",
        "label",
        "primaryField",
        "fields",
        "views"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,50}$"
        },
        "label": {
          "type": "string"
        },
        "singular": {
          "type": "string"
        },
        "primaryField": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/view"
          }
        },
        "airtable": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,50}$"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "longText",
            "email",
            "url",
            "phone",
            "number",
            "currency",
            "percent",
            "checkbox",
            "select",
            "multiSelect",
            "date",
            "dateTime",
            "rating",
            "link",
            "attachment",
            "user",
            "formula",
            "lookup",
            "rollup",
            "autoNumber",
            "createdTime",
            "updatedTime",
            "json"
          ]
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "color": {
                "enum": [
                  "gray",
                  "blue",
                  "cyan",
                  "teal",
                  "green",
                  "yellow",
                  "orange",
                  "red",
                  "pink",
                  "purple"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "link": {
          "type": "object",
          "required": [
            "table",
            "multiple"
          ],
          "properties": {
            "table": {
              "type": "string"
            },
            "multiple": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "computed": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "expr",
                "mode"
              ],
              "properties": {
                "kind": {
                  "const": "formula"
                },
                "expr": {
                  "type": "string"
                },
                "mode": {
                  "enum": [
                    "generated",
                    "app"
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "via",
                "field"
              ],
              "properties": {
                "kind": {
                  "const": "lookup"
                },
                "via": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "table",
                "linkField",
                "fn"
              ],
              "properties": {
                "kind": {
                  "const": "rollup"
                },
                "table": {
                  "type": "string"
                },
                "linkField": {
                  "type": "string"
                },
                "fn": {
                  "enum": [
                    "sum",
                    "count",
                    "avg",
                    "min",
                    "max"
                  ]
                },
                "field": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "airtable": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,50}$"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "grid",
            "kanban",
            "calendar"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "eq",
                  "neq",
                  "contains",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "empty",
                  "notEmpty",
                  "in"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "array"
                ],
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "field",
              "op"
            ],
            "additionalProperties": false
          }
        },
        "sorts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "dir"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "dir": {
                "enum": [
                  "asc",
                  "desc"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "groupBy": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "cardFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pageSize": {
          "type": "integer",
          "minimum": 10,
          "maximum": 500
        },
        "airtable": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "form": {
      "type": "object",
      "required": [
        "key",
        "label",
        "table",
        "fields"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,50}$"
        },
        "label": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public": {
          "type": "boolean"
        },
        "intro": {
          "type": "string"
        },
        "submitLabel": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dashboard": {
      "type": "object",
      "required": [
        "key",
        "label",
        "tiles",
        "charts"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,50}$"
        },
        "label": {
          "type": "string"
        },
        "tiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "table",
              "metric"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "table": {
                "type": "string"
              },
              "metric": {
                "enum": [
                  "count",
                  "sum",
                  "avg"
                ]
              },
              "field": {
                "type": "string"
              },
              "filters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "op": {
                      "enum": [
                        "eq",
                        "neq",
                        "contains",
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "empty",
                        "notEmpty",
                        "in"
                      ]
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "array"
                      ],
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "field",
                    "op"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "table",
              "groupBy",
              "metric"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "table": {
                "type": "string"
              },
              "groupBy": {
                "type": "string"
              },
              "metric": {
                "enum": [
                  "count",
                  "sum"
                ]
              },
              "field": {
                "type": "string"
              },
              "filters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "op": {
                      "enum": [
                        "eq",
                        "neq",
                        "contains",
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "empty",
                        "notEmpty",
                        "in"
                      ]
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "array"
                      ],
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "field",
                    "op"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
